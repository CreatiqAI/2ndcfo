# Copy to .env.vercel.local and fill the marked fields.
# Import .env.vercel.local into Vercel > Project > Settings > Environment Variables.
# All values are server-side. Do not add NEXT_PUBLIC_ prefixes.

# FILL: exact production HTTPS domain, no trailing slash.
APP_ORIGIN=https://YOUR-PROJECT.vercel.app
ALLOW_SIGNUP=true

# New Supabase project: btpolwpgnekvyimpqegu (Singapore).
# FILL: replace REPLACE_WITH_URL_ENCODED_DATABASE_PASSWORD with the new project's
# database password, URL-encoded. Supabase > Connect > Session pooler > URI.
# Keep port 5432: this app uses a connection-level finance schema search_path.
DATABASE_MODE=postgres
DATABASE_URL=postgresql://postgres.btpolwpgnekvyimpqegu:REPLACE_WITH_URL_ENCODED_DATABASE_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_SCHEMA=finance
DATABASE_SSL_CA_FILE=config/supabase-ca.crt

# Private bucket already created in the NEW project.
STORAGE_PROVIDER=s3
S3_BUCKET=finance-document
S3_REGION=ap-southeast-1
S3_ENDPOINT=https://btpolwpgnekvyimpqegu.storage.supabase.co/storage/v1/s3
# FILL BOTH: Supabase > Storage > S3 > Access keys (not anon/service_role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Keep your existing OpenAI key. Only the model changes.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Google login is postponed. These are NOT needed for email/password login.
# Only add these later using the NEW project's publishable (or legacy anon) key:
# SUPABASE_URL=https://btpolwpgnekvyimpqegu.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# No service_role key, temperature, top_p or reasoning settings are needed.
