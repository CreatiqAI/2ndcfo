# Local single-process preview. Production requires DATABASE_URL and S3.
DATABASE_MODE=local
DATABASE_URL=
LOCAL_DATA_DIR=.data
APP_ORIGIN=http://127.0.0.1:3000
ALLOW_SIGNUP=true
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ENDPOINT=
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are server secrets.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional external PostgreSQL schema and verified server CA
# DATABASE_SCHEMA=finance
# DATABASE_SSL_CA_FILE=config/supabase-ca.crt

# Google OAuth via Supabase Auth (server-side; configure Google provider in dashboard)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
