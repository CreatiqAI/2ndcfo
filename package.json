{
  "name": "ai-finance-budgeting-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-pdf-assets.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "worker": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/worker.ts",
    "test:http": "node --import tsx scripts/http-smoke.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"*.ts\" \"package.json\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1136.0",
    "@electric-sql/pglite": "0.5.8",
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "2.116.0",
    "csv-parse": "7.0.2",
    "drizzle-orm": "0.45.3",
    "exceljs": "4.4.0",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "engines": {
    "node": ">=24"
  }
}
